if [[ $ISTYPE == "" ]]; then
  ISTYPE=$HOST
fi
 
case $ISTYPE in
  Nucleus*)
	  thismachine=${fg_bold[green]}
		;;
	vader|r2d2)
	  thismachine=${fg_bold[magenta]}
		;;
	fas*)
	  thismachine=${fg_bold[blue]}
		;;
  augustus|flavius)
	  thismachine=${fg_bold[cyan]}
		;;
	sundev*|walleye|bass)
	  thismachine=${fg_bold[red]}
		;;
	*)
	  thismachine=${fg_bold[yellow]}
esac
